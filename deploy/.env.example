# Copy to .env and adjust.
RCC_PORT=2222
RCC_BIND=0.0.0.0           # 127.0.0.1 to reach it only via ProxyJump
RCC_DATA=/var/lib/remote-cc
RCC_IMAGE=ghcr.io/notdesigned/remote-cc-server:latest
CLAUDE_VERSION=stable      # only for local builds: or a version such as 2.1.330
# One public key per line; they are added to /root/.ssh/authorized_keys.
AUTHORIZED_KEYS=
