#!/bin/sh
# ForceCommand of every gateway account. ProxyJump (ssh -W) runs no command
# at all; a session may only ask for a self-service invite or the host key.
set -f   # no globbing of the user-supplied words below
case "${SSH_ORIGINAL_COMMAND:-}" in
  "invite "*)
    # shellcheck disable=SC2086 # split into words on purpose; rcc-self-invite validates each
    exec sudo -n /usr/local/bin/rcc-self-invite ${SSH_ORIGINAL_COMMAND#invite } ;;
  hostkey)
    awk '{print $1" "$2}' /etc/ssh/keys/ssh_host_ed25519_key.pub ;;
  *)
    echo "remote-cc gateway: this account can only reach its own container (use it as ProxyJump)" >&2
    exit 1 ;;
esac
