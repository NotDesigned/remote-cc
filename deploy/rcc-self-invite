#!/bin/sh
# Run by rcc-gateway-cmd through sudo (sudoers allows exactly this program).
# Registers the gateway half of an invite that a user issues for themselves,
# always for the calling account (SUDO_USER), never for anyone else:
#   rcc-self-invite ssh-ed25519 <base64> <16 hex id> <hours 1..168>
# The container half is added by the user's client inside their own
# container; without it this half only allows hopping to that container.
set -euf
u=${SUDO_USER:-}
bad() { echo "rcc-self-invite: $1" >&2; exit 2; }
printf '%s' "$u" | grep -Eq '^[a-z][a-z0-9-]{0,30}$' || bad "unknown caller"
grep -qx "$u" /etc/remote-cc/gateway/users || bad "unknown caller"
[ $# -eq 4 ] || bad "usage: invite ssh-ed25519 <key> <id> <hours>"
[ "$1" = ssh-ed25519 ] || bad "only ssh-ed25519 invite keys"
printf '%s' "$2" | grep -Eq '^AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}$' || bad "bad key"
printf '%s' "$3" | grep -Eq '^[0-9a-f]{16}$' || bad "bad id"
printf '%s' "$4" | grep -Eq '^[0-9]{1,3}$' || bad "bad hours"
{ [ "$4" -ge 1 ] && [ "$4" -le 168 ]; } || bad "hours must be 1..168"

f=/etc/remote-cc/invites/$u
umask 022
touch "$f"
now=$(date +%Y%m%d%H%M)
awk -v now="$now" '{ if (match($0, /expiry-time="[0-9]+"/)) { t=substr($0, RSTART+13, 12); if (t < now) next } print }' "$f" > "$f.tmp"
cat "$f.tmp" > "$f"; rm -f "$f.tmp"
[ "$(grep -c ' rcc-invite-' "$f" || true)" -lt 5 ] || bad "5 invites are already pending; use or let them expire first"
exp=$(date -d "+$4 hours" +%Y%m%d%H%M)
printf 'restrict,port-forwarding,permitopen="rcc-%s:22",expiry-time="%s" ssh-ed25519 %s rcc-invite-%s\n' "$u" "$exp" "$2" "$3" >> "$f"
echo "exp=$exp"
