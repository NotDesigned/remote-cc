# remote-cc gateway: one public port; each user may only forward to their
# own container (rcc-<user>:22). No shells, no other forwarding.
Port 22
HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKey /etc/ssh/keys/ssh_host_ecdsa_key
HostKey /etc/ssh/keys/ssh_host_rsa_key

PermitRootLogin no
PubkeyAuthentication yes
# invites/<user> holds the gateway half of one-time invite keys (forwarding to
# the user's container only); it is not visible inside the user's container.
# keys/<user>.invites is the same for servers set up by rcc 0.4.x.
AuthorizedKeysFile /etc/remote-cc/invites/%u /etc/remote-cc/keys/%u.invites /etc/remote-cc/keys/%u/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
MaxAuthTries 3
LoginGraceTime 20
MaxStartups 10:30:60

# ProxyJump (ssh -W) only; sessions are refused.
AllowTcpForwarding local
PermitOpen none
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
PermitTTY no
PermitUserEnvironment no
# Sessions may only run rcc-gateway-cmd (self-service invite, host key).
ForceCommand /usr/local/bin/rcc-gateway-cmd

ClientAliveInterval 15
ClientAliveCountMax 4
PrintMotd no
UsePAM yes

# Per-user "Match User <u> / PermitOpen rcc-<u>:22", generated by rcc-gateway-sync.
Include /etc/ssh/sshd_gateway_users.conf
