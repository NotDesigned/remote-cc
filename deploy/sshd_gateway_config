# remote-cc gateway: one public port; each user may only forward to their
# own container (rcc-<user>:22). No shells, no other forwarding.
Port 22
HostKey /etc/ssh/keys/ssh_host_ed25519_key
HostKey /etc/ssh/keys/ssh_host_ecdsa_key
HostKey /etc/ssh/keys/ssh_host_rsa_key

PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile /etc/remote-cc/keys/%u/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
MaxAuthTries 3
LoginGraceTime 20
MaxStartups 10:30:60

# ProxyJump (ssh -W) only; sessions are refused.
AllowTcpForwarding local
PermitOpen none
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
PermitTTY no
PermitUserEnvironment no
ForceCommand /bin/echo "remote-cc gateway: this account can only reach its own container (use it as ProxyJump)"

ClientAliveInterval 15
ClientAliveCountMax 4
PrintMotd no
UsePAM yes

# Per-user "Match User <u> / PermitOpen rcc-<u>:22", generated by rcc-gateway-sync.
Include /etc/ssh/sshd_gateway_users.conf
